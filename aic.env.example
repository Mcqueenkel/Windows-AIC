AIC_CHORES=1
AIC_CLUB_EVERY=60
AIC_ACE=1
AIC_TEAM=1
# claim the gift box, and every Daily Race Ticket in one multi race, once a game-day
AIC_GIFTS=1
AIC_DAILY_RACE=1
# stop each account for the game-day once it has gained 28M fans (0 margin: the
# career that crosses 28M is banked, then nothing until the 15:00 UTC reset)
AIC_FAN_TARGET=28000000
AIC_FAN_STOP_MARGIN=0
# no random wait between visits: at ~1M fans a career only full speed reaches 28M
AIC_VISIT_JITTER_MIN=0
AIC_VISIT_JITTER_MAX=0
# Discord webhooks (Server Settings > Integrations > Webhooks > Copy Webhook URL).
# Leave empty to turn off. CAREER = every finished career, ALERT = the farm is stuck.
AIC_CAREER_WEBHOOK=
AIC_ALERT_WEBHOOK=
# Only if the game is NOT in C:\Program Files (x86)\Steam: remove the # and put the
# full path of the game's master.mdb (in ...\UmamusumePrettyDerby_Data\Persistent\master\).
# AIC_MASTER_MDB=D:\SteamLibrary\steamapps\common\UmamusumePrettyDerby\UmamusumePrettyDerby_Data\Persistent\master\master.mdb
